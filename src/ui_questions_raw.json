[
  
  { "id": "a1", "topic": "algebra", "difficulty": 0.20, "text": "Solve for "x": 3x - 5 = 10", "options": {"A":"5", "B":"3", "C":"15", "D":"10"}, "correct": "A", "explanation": "Add 5 to both sides (3x = 15), then divide by 3 (x = 5)." },
  { "id": "a2", "topic": "algebra", "difficulty": 0.30, "text": ""Simplify": 2(x + 4) - x", "options": {"A":"x+8", "B":"2x+4", "C":"3x+8", "D":"x+4"}, "correct": "A", "explanation": "Expand to 2x + 8 - x, which simplifies to x + 8." },
  { "id": "a3", "topic": "algebra", "difficulty": 0.35, "text": "If y = 2x + 1 and x = 3, what is y?", "options": {"A":"5", "B":"6", "C":"7", "D":"8"}, "correct": "C", "explanation": "Substitute x="3": 2(3) + 1 = 6 + 1 = 7." },
  { "id": "a4", "topic": "algebra", "difficulty": 0.45, "text": "Factor "completely": x² - 16", "options": {"A":"(x-4)²", "B":"x(x-16)", "C":"(x-4)(x+4)", "D":"(x+16)(x-1)"}, "correct": "C", "explanation": "This is a difference of "squares": a² - b² = (a-b)(a+b)." },
  { "id": "a5", "topic": "algebra", "difficulty": 0.55, "text": "Solve "system": x+y=5, x-y=1", "options": {"A":"x=3,y=2", "B":"x=2,y=3", "C":"x=4,y=1", "D":"x=1,y=4"}, "correct": "A", "explanation": "Add "equations": 2x=6 -> x=3. "Substitute": 3+y=5 -> y=2." },
  { "id": "a6", "topic": "algebra", "difficulty": 0.60, "text": "Solve "inequality": -2x > 6", "options": {"A":"x > -3", "B":"x < -3", "C":"x > 3", "D":"x < 3"}, "correct": "B", "explanation": "Divide by -2 and flip the inequality sign to get x < -3." },
  { "id": "a7", "topic": "algebra", "difficulty": 0.65, "text": ""Expand": (x-2)(x+3)", "options": {"A":"x²-6", "B":"x²+x-6", "C":"x²-x-6", "D":"x²+x+6"}, "correct": "B", "explanation": "FOIL "method": x² + 3x - 2x - 6 = x² + x - 6." },
  { "id": "a8", "topic": "algebra", "difficulty": 0.75, "text": "Find roots of 2x² - 5x + 3 = 0", "options": {"A":"x=1, x=1.5", "B":"x=-1, x=-1.5", "C":"x=1, x=3", "D":"x=2, x=3"}, "correct": "A", "explanation": "Factor to (2x-3)(x-1)=0, giving x=1.5 and x=1." },
  { "id": "a9", "topic": "algebra", "difficulty": 0.85, "text": ""Simplify": (x³y² / x)⁻¹", "options": {"A":"x²y²", "B":"1 / (x²y²)", "C":"x/y²", "D":"x² / y²"}, "correct": "B", "explanation": "Inside simplifies to x²y². The inverse exponent makes it 1/(x²y²)." },
  { "id": "a10", "topic": "algebra", "difficulty": 0.88, "text": ""Solve": log₂(x-1) = 3", "options": {"A":"7", "B":"8", "C":"9", "D":"10"}, "correct": "C", "explanation": "2³ = x-1, so 8 = x-1, meaning x = 9." },

  
  { "id": "p1", "topic": "probability", "difficulty": 0.20, "text": "P(rolling a 4 on a standard die)", "options": {"A":"1/6", "B":"1/4", "C":"1/2", "D":"1/3"}, "correct": "A", "explanation": "There are 6 faces, one is a 4." },
  { "id": "p2", "topic": "probability", "difficulty": 0.25, "text": "P(flipping two heads in a row)", "options": {"A":"1/2", "B":"1/4", "C":"1/3", "D":"1/8"}, "correct": "B", "explanation": "(1/2) * (1/2) = 1/4." },
  { "id": "p3", "topic": "probability", "difficulty": 0.35, "text": "Probability of drawing an Ace from a deck", "options": {"A":"1/13", "B":"1/52", "C":"4/13", "D":"1/4"}, "correct": "A", "explanation": "4 Aces in 52 cards = 4/52 = 1/13." },
  { "id": "p4", "topic": "probability", "difficulty": 0.45, "text": "P(A or B) if mutually exclusive, P(A)=0.2, P(B)=0.3", "options": {"A":"0.06", "B":"0.5", "C":"0.1", "D":"0.6"}, "correct": "B", "explanation": "P(A U B) = P(A) + P(B) = 0.5." },
  { "id": "p5", "topic": "probability", "difficulty": 0.55, "text": "Expected value of a fair die roll", "options": {"A":"3", "B":"3.5", "C":"4", "D":"4.5"}, "correct": "B", "explanation": "Sum of 1 through 6 is 21. 21/6 = 3.5." },
  { "id": "p6", "topic": "probability", "difficulty": 0.60, "text": "Number of ways to arrange 3 books", "options": {"A":"3", "B":"6", "C":"9", "D":"12"}, "correct": "B", "explanation": "3! = 3 * 2 * 1 = 6." },
  { "id": "p7", "topic": "probability", "difficulty": 0.65, "text": ""Combinations": C(5, 2)", "options": {"A":"10", "B":"20", "C":"60", "D":"120"}, "correct": "A", "explanation": "5! / (2! * 3!) = 10." },
  { "id": "p8", "topic": "probability", "difficulty": 0.75, "text": "P(at least one head in 3 flips)", "options": {"A":"7/8", "B":"1/8", "C":"3/8", "D":"5/8"}, "correct": "A", "explanation": "1 - P(no heads) = 1 - (1/8) = 7/8." },
  { "id": "p9", "topic": "probability", "difficulty": 0.80, "text": ""Bayes": P(A|B) if P(A)=0.1, P(B|A)=0.8, P(B)=0.2", "options": {"A":"0.4", "B":"0.08", "C":"0.16", "D":"0.5"}, "correct": "A", "explanation": "(P(B|A)*P(A))/P(B) = (0.8*0.1)/0.2 = 0.4." },
  { "id": "p10", "topic": "probability", "difficulty": 0.85, "text": "Variance of Binomial(n=10, p=0.3)", "options": {"A":"3.0", "B":"2.1", "C":"0.21", "D":"7.0"}, "correct": "B", "explanation": "Var = n*p*(1-p) = 10 * 0.3 * 0.7 = 2.1." },

  
  { "id": "c1", "topic": "calculus", "difficulty": 0.25, "text": "Derive f(x) = x²", "options": {"A":"x", "B":"2x", "C":"2", "D":"x³/3"}, "correct": "B", "explanation": "Power "rule": bring down 2, exponent becomes 1." },
  { "id": "c2", "topic": "calculus", "difficulty": 0.30, "text": "Limit as x→0 of 3x", "options": {"A":"3", "B":"0", "C":"1", "D":"infinity"}, "correct": "B", "explanation": "Direct "substitution": 3(0) = 0." },
  { "id": "c3", "topic": "calculus", "difficulty": 0.35, "text": "Integral of 2x dx", "options": {"A":"2x² + C", "B":"x² + C", "C":"x", "D":"2"}, "correct": "B", "explanation": "Reverse power "rule": 2 * (x²/2) = x² (+C)." },
  { "id": "c4", "topic": "calculus", "difficulty": 0.45, "text": "Derive sin(x)", "options": {"A":"cos(x)", "B":"-cos(x)", "C":"-sin(x)", "D":"csc(x)"}, "correct": "A", "explanation": "Standard trigonometric derivative rules." },
  { "id": "c5", "topic": "calculus", "difficulty": 0.55, "text": "Evaluate ∫_0^2 x dx", "options": {"A":"2", "B":"4", "C":"0", "D":"1"}, "correct": "A", "explanation": "[x²/2] from 0 to 2 is 4/2 - 0 = 2." },
  { "id": "c6", "topic": "calculus", "difficulty": 0.60, "text": "Derive e^(2x)", "options": {"A":"e^(2x)", "B":"2e^(2x)", "C":"e^x", "D":"2e^x"}, "correct": "B", "explanation": "Chain rule applied to exponential function." },
  { "id": "c7", "topic": "calculus", "difficulty": 0.65, "text": "Limit as x→∞ of (2x+1)/(x-3)", "options": {"A":"2", "B":"1", "C":"infinity", "D":"0"}, "correct": "A", "explanation": "Ratio of leading coefficients is 2/1 = 2." },
  { "id": "c8", "topic": "calculus", "difficulty": 0.75, "text": "Product rule for d/dx [x * ln(x)]", "options": {"A":"ln(x) + 1", "B":"1/x", "C":"ln(x)", "D":"x/ln(x)"}, "correct": "A", "explanation": "u'v + uv' = 1*ln(x) + x*(1/x) = ln(x) + 1." },
  { "id": "c9", "topic": "calculus", "difficulty": 0.85, "text": "Determine d/dx [sin(x²)]", "options": {"A":"cos(x²)", "B":"2x*cos(x)", "C":"2x*cos(x²)", "D":"2x*sin(x²)"}, "correct": "C", "explanation": "Chain "rule": derivative of outside(inside)*derivative of inside." },
  { "id": "c10", "topic": "calculus", "difficulty": 0.88, "text": "Integration by "parts": ∫ x*e^x dx", "options": {"A":"x*e^x", "B":"e^x(x-1)+C", "C":"e^x(x+1)+C", "D":"e^x+C"}, "correct": "B", "explanation": "uv - ∫vdu with u=x, dv=e^x dx yields x*e^x - e^x." },

  
  { "id": "s1", "topic": "statistics", "difficulty": 0.15, "text": "Mean of 2, 4, 6, 8", "options": {"A":"5", "B":"20", "C":"4", "D":"6"}, "correct": "A", "explanation": "Sum is 20, divided by 4 items = 5." },
  { "id": "s2", "topic": "statistics", "difficulty": 0.25, "text": "Median of 1, 3, 100", "options": {"A":"34.6", "B":"3", "C":"1", "D":"100"}, "correct": "B", "explanation": "The middle value in sorted order is 3." },
  { "id": "s3", "topic": "statistics", "difficulty": 0.35, "text": "Mode of 1, 2, 2, 3", "options": {"A":"1", "B":"2", "C":"3", "D":"1.5"}, "correct": "B", "explanation": "2 occurs most frequently." },
  { "id": "s4", "topic": "statistics", "difficulty": 0.45, "text": "If Variance is 16, what is Standard Deviation?", "options": {"A":"4", "B":"8", "C":"256", "D":"32"}, "correct": "A", "explanation": "SD is the square root of "Variance": √16 = 4." },
  { "id": "s5", "topic": "statistics", "difficulty": 0.55, "text": "Z-score of 80 if μ=70, σ=5", "options": {"A":"1", "B":"2", "C":"10", "D":"0.5"}, "correct": "B", "explanation": "Z = (X - μ) / σ = (80 - 70) / 5 = 2." },
  { "id": "s6", "topic": "statistics", "difficulty": 0.60, "text": "In a normal distribution, % within 1 SD?", "options": {"A":"50%", "B":"68%", "C":"95%", "D":"99%"}, "correct": "B", "explanation": "Empirical "rule": ~68% falls within 1 SD of mean." },
  { "id": "s7", "topic": "statistics", "difficulty": 0.65, "text": "What is a Type I error?", "options": {"A":"False Pos", "B":"False Neg", "C":"True Pos", "D":"True Neg"}, "correct": "A", "explanation": "Rejecting a true null hypothesis." },
  { "id": "s8", "topic": "statistics", "difficulty": 0.75, "text": "A p-value of 0.03 (at α=0.05) "means":", "options": {"A":"Accept Null", "B":"Reject Null", "C":"Inconclusive", "D":"Error"}, "correct": "B", "explanation": "0.03 < 0.05, so result is statistically significant." },
